# The server only listens on localhost by default.
HOST=127.0.0.1
PORT=3000

# Published Docker port. It can differ from PORT inside the container.
DOLA_PROXY_PORT=8317

# Optional. When set, clients must send Authorization: Bearer <this value>.
DOLA_PROXY_API_KEY=change-me

# DevTools endpoint opened by scripts/start-dola.ps1.
DOLA_DEBUG_URL=http://127.0.0.1:9229
DOLA_DEBUG_PORT=9229
DOLA_REQUEST_TIMEOUT_MS=360000
DOLA_MAX_REQUEST_BYTES=33554432
DOLA_MAX_FILE_BYTES=20971520
